# CalOpen Environment Variables
# Copy to .env for `docker compose up`. NEVER commit real values.

# --- Required ---
# Free Supabase project (Auth): https://supabase.com (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Local Postgres (provided by docker-compose `db` service)
DB_PASSWORD=change-me-to-something-long-and-random

# Guest manage-link signing key (any long random string)
BOOKING_TOKEN_SECRET=generate-with-openssl-rand-hex-32

# --- Optional: PayPal subscriptions (https://developer.paypal.com) ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_TEAMS_PLAN_ID=
NEXT_PUBLIC_PAYPAL_TEAMS_PLAN_ID=

# --- Optional: Email (https://resend.com, free tier) ---
RESEND_API_KEY=
EMAIL_FROM=CalOpen <onboarding@resend.dev>

# --- Optional: Google Calendar (Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000
